{
  "name": "bunker",
  "private": true,
  "version": "0.1.0",
  "description": "BÚNKER — roguelite de supervivencia para móvil (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/clean-build.mjs && vite build",
    "preview": "vite preview --outDir ..",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.2.6",
    "@fontsource/silkscreen": "^5.2.6",
    "@preact/signals": "^2.3.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.18.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
